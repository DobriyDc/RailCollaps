# Do not upload to GitHub: personal stuff and what gets built by itself. A leading "/" — root only
# (without it build/ would also hide claude/skills/build/).
/.claude/
/upload.bat
/_utils/.backups/
/build/
/dist/
/server/leaderboard/dist/
/server/leaderboard/.wrangler/

# Студия: журналы приборов и снимки — локальные.
/.studio/health.jsonl
/.studio/usage*.jsonl
/gamestudio/snapshots/*
!/gamestudio/snapshots/.gitkeep
/.worktrees/
__pycache__/
